# Copy vào /etc/systemd/system/myzoo.service trên VPS (xem docs/SETUP_GUIDE.md)
[Unit]
Description=MyZoo Game Server
After=network.target

[Service]
User=myzoo
WorkingDirectory=/opt/myzoo
ExecStart=/usr/bin/java -Xms128m -Xmx512m -jar /opt/myzoo/myzoo-server.jar
Environment=SERVER_PORT=8080
Environment=CLIENT_DIR=/opt/myzoo/client
# Dùng MySQL thì bỏ comment 3 dòng dưới (mặc định là H2 file ./myzoo-data trong WorkingDirectory)
#Environment=DB_URL=jdbc:mysql://localhost:3306/myzoo
#Environment=DB_USER=myzoo
#Environment=DB_PASSWORD=doi-mat-khau-nay
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
