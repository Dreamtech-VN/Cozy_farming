# Cấu hình runtime (doc 21). Copy thành .env và chỉnh theo environment.

NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# BẮT BUỘC đặt giá trị ngẫu nhiên đủ dài ở staging/production.
# Sinh nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TOKEN_SECRET=

ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=2592000

# Đường dẫn dữ liệu; dùng :memory: cho test.
DB_FILE=./var/game.db
DATA_DIR=./data/content
LOCALE_DIR=./locales
CLIENT_DIR=./client

# Realtime (doc 16)
WORLD_TICK_MS=100
PRESENCE_TIMEOUT_MS=30000

LOG_LEVEL=info
